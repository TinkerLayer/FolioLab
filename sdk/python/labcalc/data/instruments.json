  "temperatur": {"de": "Temperatur", "en": "Temperature"},
  "kraft": {"de": "Kraft", "en": "Force"},
  "weg": {"de": "Weg, Dehnung", "en": "Displacement, strain"},
  "allgemein": {"de": "Allgemein", "en": "General"},
  "own": {"de": "Eigene Messmittel", "en": "Own instruments"}
 },
